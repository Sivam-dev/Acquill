# Groq API key (your own - LLM for chat and analysis)
GROQ_API_KEY=your_groq_api_key_here

# Jina AI API key (your own - embeddings for semantic search)
JINA_API_KEY=your_jina_api_key_here

# Supabase: shared Acquill project is used automatically.
# Only set these to override with your own project.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_publishable_key_here

# Git Diff Check Interval (seconds)
GIT_CHECK_INTERVAL=300

# Opt out of background git monitoring for this run (true/false)
# GIT_MONITORING=true
