# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_anon_key_here

# Groq API (optional - uses local Ollama if not provided)
GROQ_API_KEY=your_groq_api_key_here_optional

# Git Diff Check Interval (seconds)
GIT_DIFF_CHECK_INTERVAL=300

# LangGraph checkpointing (Supabase Postgres connection string)
CHECKPOINT_DB_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
